# Copy this file to .env.local and fill in the two values from
# Supabase Dashboard > Project Settings > API.
# Use the "anon public" key. NEVER put the service_role key in this file or in the app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Only if your password Edge Function has a different URL name than admin-set-password:
# VITE_ADMIN_PASSWORD_FUNCTION=admin-set-password
